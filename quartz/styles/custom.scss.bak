@use "./base.scss";
// put your custom CSS here!

html {
  scroll-padding-top: 0;
}

#quartz-root, #quartz-body {
  scroll-margin-top: 0;
  scroll-padding-top: 0;
}

h1 {
  text-align: right;
}

h1:nth-of-type(1) {
  margin-bottom: 0;
}

h1:nth-of-type(2) {
  margin-top: 0;
  color: #2d6a4f;
}

h1:nth-of-type(2) em {
  color: #2b2b2b;
}

a {
  color: #2d6a4f;
}

a:hover {
  color: #1b4332;
}

a.internal {
  background-color: var(--highlight);
  border-radius: 4px;
  padding: 2px 6px;
  text-decoration: none;
}

a.internal:hover {
  background-color: var(--lightgray);
}

ol ol {
  list-style-type: lower-alpha;
}

// Image styling
article img {
  border: 1px solid var(--lightgray);
  border-radius: 4px;
  padding: 4px;
}

// Contact card with course icon
.contact-card {
  display: flex;
  align-items: flex-start;
  gap: 1.5rem;
  border: 1px solid var(--lightgray);
  border-radius: 8px;
  padding: 1.5rem;
  margin: 1rem 0 2rem 0;
  background-color: var(--highlight);
}

.course-icon {
  width: 4rem;
  opacity: 0.4;
  flex-shrink: 0;
}

.course-icon-wide {
  width: 18rem;
}

.contact-info p {
  margin: 0.3rem 0;
}

// Hide clutter 

.article-title,
.content-meta {
  display: none;
}

/* 1. Kill the header and any spacing it creates */
.article-header, 
header.page-header,
.breadcrumb-container {
  display: none !important;
  margin: 0 !important;
  padding: 0 !important;
  height: 0 !important;
  min-height: 0 !important;
}


/* 2. Flatten the article container */
article, 
.center, 
#quartz-body {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

/* 3. Target the 'aligner' - Quartz uses this to center content, 
   it often has its own top padding */
.center > .aligner {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

/* 4. Ensure your H1 (or first element) has zero top margin */
article > :first-child,
article > .aligner > :first-child {
  margin-top: 0 !important;
}
